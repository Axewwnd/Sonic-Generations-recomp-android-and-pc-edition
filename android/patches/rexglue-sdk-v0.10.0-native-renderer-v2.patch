+/**
+ * @file        graphics/null/null_graphics_system.cpp
+ * @brief       Null GPU plugin - presentation without Xenos emulation
+ *
+ * Used when native renderer draws directly via RHI (like Skate3)
+ * Guest GPU interface is no-op: ring buffer, interrupts ignored
+ * because game uses native D3D9 hooks instead of Xenos PM4
+ * Fixed for SDK v0.10.0 - no CreateGraphicsProvider API
+ */
+
+#include <rex/system/interfaces/graphics.h>
+#include <rex/logging.h>
+#include <rex/system/xtypes.h>
+
+using rex::X_STATUS;
+
+namespace rex::graphics::null {
+
+class NullGraphicsSystem : public system::IGraphicsSystem {
+ public:
+  X_STATUS SetupPresentation(ui::WindowedAppContext* app_context) override {
+    (void)app_context;
+    REXLOG_INFO("NullGraphicsSystem: SetupPresentation - native renderer will draw directly");
+    REXLOG_INFO("  This is for EXPERIMENTAL native path - if black screen, use xenos");
+    has_presentation_ = true;
+    return X_STATUS_SUCCESS;
+  }
+  
+  X_STATUS SetupGuestGpu(runtime::FunctionDispatcher* function_dispatcher,
+                         system::KernelState* kernel_state) override {
+    REXLOG_INFO("NullGraphicsSystem: SetupGuestGpu - Xenos emulation DISABLED, native path active");
+    (void)function_dispatcher;
+    (void)kernel_state;
+    return X_STATUS_SUCCESS;
+  }
+  
+  bool has_presentation() const override { return has_presentation_; }
+  
+  void SetInterruptCallback(uint32_t callback, uint32_t user_data) override {
+    (void)callback; (void)user_data;
+  }
+  
+  void InitializeRingBuffer(uint32_t ptr, uint32_t size_log2) override {
+    (void)ptr; (void)size_log2;
+  }
+  
+  void EnableReadPointerWriteBack(uint32_t ptr, uint32_t block_size_log2) override {
+    (void)ptr; (void)block_size_log2;
+  }
+  
+  void InitializeShaderStorage(const std::filesystem::path& cache_root, uint32_t title_id, bool blocking) override {
+    (void)cache_root; (void)title_id; (void)blocking;
+  }
+  
+  void Shutdown() override {
+    has_presentation_ = false;
+  }
+  
+ private:
+  bool has_presentation_ = false;
+};
+
+}  // namespace rex::graphics::null
+
+namespace rex::system {
+std::unique_ptr<IGraphicsSystem> CreateNullGraphicsSystem() {
+  return std::make_unique<graphics::null::NullGraphicsSystem>();
+}
+}  // namespace rex::system
--- /dev/null
+++ b/src/graphics/null/plugin_main.cpp
@@ -0,0 +1,32 @@
+/**
+ * @file        graphics/null/plugin_main.cpp
+ * @brief       rexgpu-null plugin entry points
+ */
+
+#include <rex/system/gpu_plugin.h>
+#include <rex/logging.h>
+#include <rex/system/interfaces/graphics.h>
+
+namespace rex::system {
+std::unique_ptr<IGraphicsSystem> CreateNullGraphicsSystem();
+}
+
+extern "C" REX_GPU_PLUGIN_EXPORT uint32_t rex_gpu_abi_version(void) {
+  return rex::system::kGpuPluginAbiVersion;
+}
+
+extern "C" REX_GPU_PLUGIN_EXPORT rex::system::IGraphicsSystem* rex_gpu_create(
+    uint32_t abi_version, const rex::system::GpuCreateInfo* info) {
+  if (abi_version != rex::system::kGpuPluginAbiVersion) {
+    REXLOG_ERROR("rexgpu-null: ABI mismatch {} vs {}",
+                 abi_version, rex::system::kGpuPluginAbiVersion);
+    return nullptr;
+  }
+  if (!info || info->struct_size < sizeof(rex::system::GpuCreateInfo)) {
+    REXLOG_ERROR("rexgpu-null: invalid GpuCreateInfo");
+    return nullptr;
+  }
+  
+  REXLOG_INFO("rexgpu-null: creating null graphics system for native renderer");
+  return rex::system::CreateNullGraphicsSystem().release();
+}
