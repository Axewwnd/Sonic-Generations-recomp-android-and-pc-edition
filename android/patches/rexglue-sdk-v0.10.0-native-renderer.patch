+# rexgpu-null: null GPU plugin for native rendering
+# Provides presentation without Xenos emulation
+# The game renders via native RHI directly
+
+add_library(rexgpu-null SHARED
+    null_graphics_system.cpp
+    plugin_main.cpp
+)
+
+target_include_directories(rexgpu-null PRIVATE
+    "${CMAKE_CURRENT_SOURCE_DIR}/../.."
+    "${CMAKE_CURRENT_SOURCE_DIR}/../../include"
+)
+
+target_link_libraries(rexgpu-null PRIVATE rex::runtime rexgraphics rexui)
+rexglue_apply_target_settings(rexgpu-null)
+
+set_target_properties(rexgpu-null PROPERTIES OUTPUT_NAME "rexgpu-null")
