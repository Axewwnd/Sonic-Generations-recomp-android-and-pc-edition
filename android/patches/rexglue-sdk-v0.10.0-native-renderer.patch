@@ -0,0 +1,32 @@
+/**
+ * @file        graphics/null/plugin_main.cpp
+ * @brief       rexgpu-null plugin entry points
+ */
+
+#include <rex/system/gpu_plugin.h>
+#include <rex/logging.h>
+#include <rex/system/interfaces/graphics.h>
+
+namespace rex::system {
+std::unique_ptr<IGraphicsSystem> CreateNullGraphicsSystem();
+}
+
+extern "C" REX_GPU_PLUGIN_EXPORT uint32_t rex_gpu_abi_version(void) {
+  return rex::system::kGpuPluginAbiVersion;
+}
+
+extern "C" REX_GPU_PLUGIN_EXPORT rex::system::IGraphicsSystem* rex_gpu_create(
+    uint32_t abi_version, const rex::system::GpuCreateInfo* info) {
+  if (abi_version != rex::system::kGpuPluginAbiVersion) {
+    REXLOG_ERROR("rexgpu-null: ABI mismatch {} vs {}", abi_version,
+                 rex::system::kGpuPluginAbiVersion);
+    return nullptr;
+  }
+  if (!info || info->struct_size < sizeof(rex::system::GpuCreateInfo)) {
+    REXLOG_ERROR("rexgpu-null: invalid GpuCreateInfo");
+    return nullptr;
+  }
+  
+  REXLOG_INFO("rexgpu-null: creating null graphics system for native renderer");
+  return rex::system::CreateNullGraphicsSystem().release();
+}
